{
  "name": "@kvman/kvvideo",
  "version": "0.0.0",
  "description": "kvvideo: the kvcoder extension that makes videos of the person's app, recorded, narrated, and captioned.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibndeif/kvman.git",
    "directory": "extensions/kvvideo"
  },
  "homepage": "https://github.com/ibndeif/kvman#readme",
  "bugs": {
    "url": "https://github.com/ibndeif/kvman/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "fonts",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node web-build.config.ts",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p tsconfig.web.json"
  },
  "peerDependencies": {
    "@kvman/sdk": "^0.1.5"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@kvman/kvai": "workspace:*",
    "@kvman/kvcoder": "workspace:*",
    "@kvman/kvwebui": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "@kvman/testkit": "workspace:*",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "kvman": {
    "namespace": "kvvideo",
    "source": "src/index.ts",
    "web": "dist/web",
    "dependencies": {
      "@kvman/kvcoder": "^0.1.2",
      "@kvman/kvwebui": "^0.1.0"
    },
    "indexes": {
      "players": [
        [
          "path"
        ]
      ]
    }
  }
}
