{
  "name": "@kvman/kvcoder",
  "version": "0.1.0",
  "private": true,
  "description": "kvcoder: the app-building harness, with one shell tool, connectors, sections, and its conversation UI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@kvman/source": "./src/connector-line.ts",
      "types": "./dist/connector-line.d.ts",
      "default": "./dist/connector-line.js"
    }
  },
  "files": [
    "docs",
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node web-build.config.ts",
    "typecheck": "tsc -p tsconfig.json && vue-tsc -p tsconfig.web.json"
  },
  "peerDependencies": {
    "@kvman/sdk": "^0.1.0"
  },
  "dependencies": {
    "@lucide/vue": "1.49.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@kvman/kvai": "workspace:*",
    "@kvman/kvwebui": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "@kvman/testkit": "workspace:*",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "kvman": {
    "namespace": "kvcoder",
    "source": "src/index.ts",
    "web": "dist/web",
    "dependencies": {
      "@kvman/kvai": "^0.1.0",
      "@kvman/kvwebui": "^0.1.0"
    }
  }
}
