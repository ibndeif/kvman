{
  "name": "@kvman/kvdev",
  "version": "0.1.0",
  "private": true,
  "description": "kvdev: the harness for developing kvman extensions and presets, on kvcoder.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "locales",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@kvman/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@kvman/kvai": "workspace:*",
    "@kvman/kvcoder": "workspace:*",
    "@kvman/kvwebui": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "@kvman/testkit": "workspace:*",
    "playwright": "1.63.0"
  },
  "kvman": {
    "namespace": "kvdev",
    "source": "src/index.ts",
    "dependencies": {
      "@kvman/kvcoder": "^0.1.0"
    }
  }
}
