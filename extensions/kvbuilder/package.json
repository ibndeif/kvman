{
  "name": "@kvman/kvcustomizer",
  "version": "0.1.1",
  "description": "kvcustomizer: the kvcoder extension for customizing kvman, building extensions and presets and managing the running app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibndeif/kvman.git",
    "directory": "extensions/kvcustomizer"
  },
  "homepage": "https://github.com/ibndeif/kvman#readme",
  "bugs": {
    "url": "https://github.com/ibndeif/kvman/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@kvman/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@kvman/kvai": "workspace:*",
    "@kvman/kvcoder": "workspace:*",
    "@kvman/kvwebui": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "playwright": "1.63.0"
  },
  "kvman": {
    "namespace": "kvcustomizer",
    "source": "src/index.ts",
    "dependencies": {
      "@kvman/kvai": "^0.1.0",
      "@kvman/kvcoder": "^0.1.0"
    }
  },
  "dependencies": {
    "@kvman/testkit": "workspace:*"
  }
}
