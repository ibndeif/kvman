{
  "name": "@kvman/sdk",
  "version": "0.1.1",
  "description": "The kvman extension API: the ctx types, zod, and the shared shapes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibndeif/kvman.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ibndeif/kvman#readme",
  "bugs": {
    "url": "https://github.com/ibndeif/kvman/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@kvman/source": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
