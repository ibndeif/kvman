{
  "name": "@kvman/kernel",
  "version": "0.0.0",
  "description": "The kvman kernel: message routing, scheduling, storage, and hosts. kvman start runs it as the daemon.",
  "type": "module",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./daemon": {
      "@kvman/source": "./src/daemon/daemon-main.ts",
      "types": "./dist/daemon/daemon-main.d.ts",
      "default": "./dist/daemon/daemon-main.js"
    }
  },
  "files": [
    "dist",
    "builtin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@kvman/protocol": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "es-module-lexer": "3.0.2",
    "fastify": "5.12.5",
    "intl-messageformat": "12.1.2",
    "pino": "10.3.1",
    "pnpm": "12.6.0",
    "semver": "7.8.5",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/semver": "7.8.0",
    "fast-check": "4.10.2"
  }
}
