    "better-sqlite3": "13.0.3",
    "pino": "10.3.1",
    "semver": "7.8.5",
    "croner": "10.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/semver": "7.8.0"
  }
