{
  "name": "@kvman/kernel",
  "version": "0.0.0",
  "description": "The kvman kernel: message routing, scheduling, storage, and hosts. kvman start runs it as the daemon.",
  "type": "module",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kvman/protocol": "workspace:*",
    "@kvman/sdk": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
