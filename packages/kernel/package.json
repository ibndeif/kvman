{
  "name": "@kvman/kernel",
  "version": "0.1.0",
  "description": "The kvman kernel: jobs, workers, storage, extensions, and HTTP.",
  "type": "module",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
