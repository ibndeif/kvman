{
  "name": "@kvman/testkit",
  "version": "0.1.0",
  "description": "createTestKernel: the real kvman kernel for extension tests.",
  "type": "module",
  "exports": {
    ".": {
      "@kvman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake-openai": {
      "@kvman/source": "./src/fake-openai.ts",
      "types": "./dist/fake-openai.d.ts",
      "default": "./dist/fake-openai.js"
    }
  },
  "bin": {
    "kvman-check": "./dist/check-bin.js",
    "kvman-docs": "./dist/docs/docs-bin.js",
    "kvman-new": "./dist/new/new-bin.js",
    "kvman-preset": "./dist/preset/preset-bin.js"
  },
  "files": [
    "dist",
    "docs",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kvman/kernel": "workspace:*",
    "@kvman/sdk": "workspace:*"
  }
}
