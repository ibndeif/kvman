{
  "manifestVersion": 1,
  "meta": {
    "name": "@acme/pdf",
    "version": "1.2.0",
    "namespace": "pdf",
    "title": "$t.meta.title",
    "summary": "$t.meta.summary",
    "icon": "file-text",
    "description": "Import PDF files and translate them with the configured AI model.",
    "implements": []
  },
  "permissions": {
    "capabilities": [
      {
        "name": "llm",
        "reason": "$t.reasons.llm"
      },
      {
        "name": "ui",
        "reason": "$t.reasons.ui"
      }
    ],
    "isolation": null,
    "requireTypes": [],
    "requireComponents": []
  },
  "types": [
    {
      "type": "pdf.imported",
      "kind": "event",
      "description": "A PDF was imported.",
      "delivery": "durable",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "pdf.translated",
      "kind": "event",
      "description": "A translation finished.",
      "delivery": "durable",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          },
          "blobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          }
        },
        "required": [
          "fileId",
          "blobId"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "pdf.progress.updated",
      "kind": "event",
      "description": "Translation text for one file, as it is generated.",
      "delivery": "live",
      "chunk": "text"
    },
    {
      "type": "pdf.import",
      "kind": "command",
      "description": "Import an uploaded PDF blob.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "blobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          }
        },
        "required": [
          "blobId"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "blobId": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
        }
      ],
      "lane": "blob:{{ $payload.blobId }}",
      "access": "all",
      "handler": "command:pdf.import"
    },
    {
      "type": "pdf.translate",
      "kind": "command",
      "description": "Translate a PDF to a target language.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          },
          "lang": {
            "type": "string",
            "description": "Target language code"
          }
        },
        "required": [
          "fileId",
          "lang"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "blobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          }
        },
        "required": [
          "blobId"
        ],
        "additionalProperties": false
      },
      "lane": "file:{{ $payload.fileId }}",
      "concurrency": 2,
      "timeoutMs": 300000,
      "access": "all",
      "agentTool": {
        "title": "Translate PDF"
      },
      "handler": "command:pdf.translate"
    },
    {
      "type": "pdf.files.prune",
      "kind": "command",
      "description": "Delete failed imports older than 30 days.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "access": "internal",
      "handler": "command:pdf.files.prune"
    },
    {
      "type": "pdf.files.list",
      "kind": "query",
      "description": "List imported files, newest first.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "importing",
              "ready",
              "translating",
              "translated",
              "failed"
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "blobId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "format": "kvman-blob-id"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "importing",
                    "ready",
                    "translating",
                    "translated",
                    "failed"
                  ]
                },
                "pages": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "translatedBlobId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "format": "kvman-blob-id"
                },
                "createdAt": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "blobId",
                "status",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "access": "all",
      "handler": "query:pdf.files.list"
    },
    {
      "type": "pdf.files.count",
      "kind": "query",
      "description": "Count files, optionally by status.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "importing",
              "ready",
              "translating",
              "translated",
              "failed"
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "count"
        ],
        "additionalProperties": false
      },
      "access": "all",
      "handler": "query:pdf.files.count"
    },
    {
      "type": "pdf.file.get",
      "kind": "query",
      "description": "Get one file by id.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "blobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          },
          "status": {
            "type": "string",
            "enum": [
              "importing",
              "ready",
              "translating",
              "translated",
              "failed"
            ]
          },
          "pages": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "translatedBlobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          },
          "createdAt": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "blobId",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "access": "all",
      "handler": "query:pdf.file.get"
    }
  ],
  "subscriptions": [],
  "schedules": [
    {
      "name": "prune",
      "description": "Hourly cleanup.",
      "every": "1h",
      "command": "pdf.files.prune"
    }
  ],
  "data": {
    "version": 1,
    "compatibleWith": [],
    "migrations": [],
    "collections": [
      {
        "name": "files",
        "description": "Imported PDF files.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "blobId": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "format": "kvman-blob-id"
            },
            "status": {
              "type": "string",
              "enum": [
                "importing",
                "ready",
                "translating",
                "translated",
                "failed"
              ]
            },
            "pages": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "translatedBlobId": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "format": "kvman-blob-id"
            },
            "createdAt": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "name",
            "blobId",
            "status",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "idField": "id",
        "indexes": [
          [
            "status",
            "createdAt"
          ]
        ]
      }
    ],
    "logs": []
  },
  "entities": [
    {
      "name": "pdf.file",
      "description": "An imported PDF file.",
      "title": "$t.entities.file",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "blobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          },
          "status": {
            "type": "string",
            "enum": [
              "importing",
              "ready",
              "translating",
              "translated",
              "failed"
            ]
          },
          "pages": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "translatedBlobId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "kvman-blob-id"
          },
          "createdAt": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "blobId",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "idField": "id",
      "display": {
        "title": "$item.name",
        "subtitle": "$item.status",
        "icon": "file-text"
      },
      "route": "/files/{{ $item.id }}"
    }
  ],
  "config": {
    "scope": "workspace",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "defaultLanguage": {
          "default": "ar",
          "description": "Target language code",
          "label": "$t.settings.defaultLanguage",
          "type": "string"
        }
      },
      "required": [
        "defaultLanguage"
      ],
      "additionalProperties": false
    }
  },
  "errors": [
    {
      "code": "pdf/NOT_FOUND",
      "description": "The file id does not exist in this workspace.",
      "title": "No such file",
      "retryable": false
    }
  ],
  "ui": {
    "pages": [
      {
        "id": "pdf.files",
        "description": "Uploaded PDF files with their translation status.",
        "route": "/files",
        "title": "$t.files.title",
        "icon": "files",
        "state": {
          "filter": null
        },
        "queries": {
          "files": {
            "query": "pdf.files.list",
            "payload": {
              "status": "$state.filter"
            },
            "refreshOn": [
              "pdf.*"
            ]
          }
        },
        "view": {
          "type": "stack",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "heading",
                  "text": {
                    "$t": "files.count",
                    "count": "$query.files.items.length"
                  }
                },
                {
                  "type": "select",
                  "value": "$state.filter",
                  "placeholder": "$t.filter.all",
                  "options": [
                    [
                      "ready",
                      "$t.status.ready"
                    ],
                    [
                      "translated",
                      "$t.status.translated"
                    ]
                  ],
                  "onChange": {
                    "set": {
                      "$state.filter": "$value"
                    }
                  }
                }
              ]
            },
            {
              "type": "upload",
              "accept": [
                "application/pdf"
              ],
              "label": "$t.upload.drop",
              "onUpload": {
                "command": "pdf.import",
                "payload": {
                  "blobId": "$upload.blobId"
                },
                "then": [
                  {
                    "toast": {
                      "$t": "toast.imported",
                      "name": "$upload.name"
                    }
                  }
                ]
              }
            },
            {
              "type": "table",
              "entity": "pdf.file",
              "data": "$query.files.items",
              "emptyState": {
                "title": "$t.empty.title",
                "body": "$t.empty.body"
              },
              "columns": [
                {
                  "field": "name",
                  "label": "$t.columns.name"
                },
                {
                  "field": "status",
                  "label": "$t.columns.status",
                  "as": "badge"
                },
                {
                  "field": "createdAt",
                  "label": "$t.columns.added",
                  "format": "relative"
                },
                {
                  "label": "$t.columns.progress",
                  "as": "liveText",
                  "live": "pdf.progress.updated:{{ $item.id }}",
                  "visibleIf": {
                    "$item.status": "translating"
                  }
                }
              ],
              "rowActions": "auto",
              "onRowClick": {
                "navigate": "/files/{{ $item.id }}"
              }
            }
          ]
        }
      },
      {
        "id": "pdf.file-detail",
        "description": "One PDF file with its original and its translation.",
        "route": "/files/:fileId",
        "title": "$t.files.detail",
        "icon": "file-text",
        "params": {
          "fileId": "string"
        },
        "queries": {
          "file": {
            "query": "pdf.file.get",
            "payload": {
              "fileId": "$route.fileId"
            },
            "refreshOn": [
              "pdf.translated"
            ]
          }
        },
        "view": {
          "type": "page",
          "title": "$query.file.name",
          "entity": "pdf.file",
          "record": "$query.file",
          "actions": [
            {
              "type": "button",
              "label": "$t.actions.back",
              "icon": "arrow-left",
              "variant": "ghost",
              "onClick": {
                "navigate": "/files"
              }
            }
          ],
          "children": [
            {
              "type": "split",
              "children": [
                {
                  "type": "pdf.viewer",
                  "blobId": "$query.file.blobId"
                },
                {
                  "type": "section",
                  "title": "$t.files.translation",
                  "children": [
                    {
                      "type": "emptyState",
                      "title": "$t.files.notTranslated",
                      "visibleIf": {
                        "$query.file.translatedBlobId": {
                          "exists": false
                        }
                      }
                    },
                    {
                      "type": "fileLink",
                      "blobId": "$query.file.translatedBlobId",
                      "name": "$query.file.name",
                      "visibleIf": {
                        "$query.file.translatedBlobId": {
                          "exists": true
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "navGroups": [
      {
        "id": "pdf.documents",
        "description": "Document tools in the sidebar.",
        "label": "$t.nav.documents",
        "icon": "folder"
      }
    ],
    "navItems": [
      {
        "id": "pdf.nav-files",
        "description": "Files page in the sidebar.",
        "page": "pdf.files",
        "group": "pdf.documents",
        "label": "$t.nav.files",
        "icon": "files"
      }
    ],
    "toolbarItems": [],
    "statusItems": [
      {
        "id": "pdf.queue",
        "description": "Number of translations in progress.",
        "icon": "loader",
        "queries": {
          "q": {
            "query": "pdf.files.count",
            "payload": {
              "status": "translating"
            },
            "refreshOn": [
              "pdf.*"
            ]
          }
        },
        "visibleIf": {
          "$query.q.count": {
            "gt": 0
          }
        },
        "label": {
          "$t": "status.translating",
          "count": "$query.q.count"
        },
        "action": {
          "navigate": "/files"
        }
      }
    ],
    "panels": [],
    "slots": [],
    "actions": [
      {
        "id": "pdf.translate",
        "description": "Translate a PDF from its row menu.",
        "entity": "pdf.file",
        "label": "$t.actions.translate",
        "icon": "languages",
        "command": "pdf.translate",
        "payload": {
          "fileId": "$item.id"
        },
        "form": true,
        "visibleIf": {
          "$item.status": {
            "in": [
              "ready",
              "translated"
            ]
          }
        }
      }
    ],
    "rendererTargets": [],
    "renderers": [
      {
        "id": "pdf.preview",
        "description": "Shows PDF blobs with the viewer.",
        "target": "mime:application/pdf",
        "component": "pdf.viewer",
        "props": {
          "blobId": "$item.blobId"
        }
      }
    ],
    "components": [
      {
        "id": "pdf.fileCard",
        "description": "Compact card for one PDF file with its status and an Open button.",
        "visibility": "public",
        "view": {
          "type": "card",
          "children": [
            {
              "type": "heading",
              "text": "$props.file.name"
            },
            {
              "type": "badge",
              "text": "$props.file.status"
            },
            {
              "type": "button",
              "label": "$t.card.open",
              "onClick": "$props.onOpen",
              "visibleIf": {
                "$props.onOpen": {
                  "exists": true
                }
              }
            }
          ]
        }
      },
      {
        "id": "pdf.viewer",
        "description": "Paged PDF viewer.",
        "props": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "blobId": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "format": "kvman-blob-id"
            }
          },
          "required": [
            "blobId"
          ],
          "additionalProperties": false
        },
        "widget": "widgets/viewer.html"
      }
    ],
    "settingsSection": null
  },
  "translations": {
    "default": "en",
    "catalogs": {
      "en": {
        "meta": {
          "title": "PDF Translator",
          "summary": "Import PDF files and translate them."
        },
        "reasons": {
          "llm": "Translates documents with your AI model",
          "ui": "Shows a notice when a translation finishes"
        },
        "entities": {
          "file": "PDF file"
        },
        "settings": {
          "defaultLanguage": "Default target language"
        },
        "nav": {
          "documents": "Documents",
          "files": "Files"
        },
        "files": {
          "title": "Files",
          "detail": "File",
          "translation": "Translation",
          "notTranslated": "Not translated yet",
          "count": "{count, plural, =0 {No files} one {# file} other {# files}}",
          "pages": "{count, plural, one {# page} other {# pages}}"
        },
        "status": {
          "ready": "Ready",
          "translated": "Translated",
          "translating": "{count, plural, one {Translating # file} other {Translating # files}}"
        },
        "filter": {
          "all": "All files"
        },
        "upload": {
          "drop": "Drop a PDF here"
        },
        "columns": {
          "name": "Name",
          "status": "Status",
          "added": "Added",
          "progress": "Progress"
        },
        "empty": {
          "title": "No files yet",
          "body": "Upload a PDF to start."
        },
        "actions": {
          "translate": "Translate",
          "back": "Back"
        },
        "card": {
          "open": "Open"
        },
        "toast": {
          "imported": "{name} is imported",
          "translated": "{name} is translated"
        },
        "notify": {
          "translated": "{name} is translated"
        },
        "problems": {
          "NOT_FOUND": "This file no longer exists."
        }
      },
      "ar": {
        "meta": {
          "title": "مترجم PDF",
          "summary": "استورد ملفات PDF وترجمها."
        },
        "reasons": {
          "llm": "يترجم المستندات بنموذج الذكاء الاصطناعي الخاص بك",
          "ui": "يعرض إشعارًا عند انتهاء الترجمة"
        },
        "entities": {
          "file": "ملف PDF"
        },
        "settings": {
          "defaultLanguage": "لغة الترجمة الافتراضية"
        },
        "nav": {
          "documents": "المستندات",
          "files": "الملفات"
        },
        "files": {
          "title": "الملفات",
          "detail": "ملف",
          "translation": "الترجمة",
          "notTranslated": "لم تُترجم بعد",
          "count": "{count, plural, =0 {لا توجد ملفات} one {ملف واحد} two {ملفان} few {# ملفات} many {# ملفًا} other {# ملف}}",
          "pages": "{count, plural, one {صفحة واحدة} two {صفحتان} few {# صفحات} many {# صفحة} other {# صفحة}}"
        },
        "status": {
