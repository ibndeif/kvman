{
  "name": "@kvman/vscode",
  "version": "0.4.11",
  "description": "The kvman VS Code extension: kvman in VS Code's secondary side bar.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.page.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.page.json --noEmit",
    "package": "cd dist/extension && vsce package --no-dependencies --out ../kvman.vsix"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "happy-dom": "20.14.5",
    "ovsx": "1.3.0",
    "vite": "8.3.1"
  }
}
